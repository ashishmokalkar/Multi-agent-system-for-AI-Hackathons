# Required only for real OpenAI-agent execution.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Required only when invoking adapters backed by the existing competition code.
AUDIO_AGENTS_ORIGINAL_REPO=/path/to/existing/competition/repository

# Optional overrides.
AUDIO_AGENTS_RUN_ROOT=./runs
AUDIO_AGENTS_CONFIG=./configs/default.toml
